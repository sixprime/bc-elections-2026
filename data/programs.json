        }
      ]
    },
    {
      "id": "green",
      "sourceIds": [
        "program-green-2026",
        "program-green-2024",
        "program-green-2024-pdf"
      ],
      "quotes": [
        {
          "id": "affordability-2026",
          "topic": "affordability",
          "text": "A Life You Can Afford",
          "sourceId": "program-green-2026",
          "locator": "2026 campaign commitments",
          "speaker": "BC Green Party",
          "textSha256": "f7457f258547ffad9c80d8a348ecc50091f6162207ae5e4b01f142bd540b164e"
        },
        {
          "id": "care-2026",
          "topic": "health",
          "text": "Care You Can Count On",
          "sourceId": "program-green-2026",
          "locator": "2026 campaign commitments",
          "speaker": "BC Green Party",
          "textSha256": "432c26fe7d04f31f81669914c3ff5a672c4f59b671ca2edf6cd11609dedeb9ad"
        },
        {
          "id": "fair-economy-2026",
          "topic": "economy",
          "text": "The BC Greens are ready to do the work to build a fair economy.",
          "speaker": "Emily Lowan",
          "sourceId": "program-green-2026",
          "textSha256": "cf5162051f751c3efd375cb293025d0d03e9e21d0e3c85a4d1240ec49885ae45"
        },
        {
          "id": "future-2026",
          "topic": "environment",
          "text": "Fight for your Future",
          "sourceId": "program-green-2026",
          "locator": "2026 campaign commitments",
          "speaker": "BC Green Party",
          "textSha256": "3dfa4973aee45bbb533fdc1f631fd0bc292b6e92ef265d8e31be5a7647f16a75"
        },
        {
          "id": "housing-2024",
          "topic": "housing",
          "text": "The private sector alone cannot deliver the affordable housing we need.",
          "sourceId": "program-green-2024-pdf",
          "locator": "PDF page 25",
          "speaker": "BC Green Party",
          "textSha256": "3c264df1f6eca3615bd6e3684967240364ffaa934a1ff7e542fd6bf789375b1b"
        },
        {
          "id": "workforce-2024",
          "topic": "health",
          "text": "Investing in our health workforce is essential for a sustainable future.",
          "sourceId": "program-green-2024-pdf",
          "locator": "PDF page 9",
          "speaker": "BC Green Party",
          "textSha256": "680166017aeabd0f3ca0e93511100d4237abf63e04346a5b1cf1ffafe759086c"
        },
        {
          "id": "ministers-2024",
          "topic": "governance",
          "text": "Require all Ministers to provide evidence on how their work contributes to increasing wellbeing in British Columbia as part of each budget presentation.",
          "sourceId": "program-green-2024-pdf",
          "locator": "PDF page 5",
          "speaker": "BC Green Party",
          "textSha256": "5274bd2bd4c976f71ec95f487d1da46889b4a38f63f9f8f2080a0952f443ae1c"
        },
        {
          "id": "first-nations-2024",
          "topic": "indigenous",
          "text": "Ensure that First Nations are central to the development and implementation of the Wellbeing Framework, fostering collaboration and respect.",
          "sourceId": "program-green-2024-pdf",
          "locator": "PDF page 5",
          "speaker": "BC Green Party",
          "textSha256": "8beb66f9a7a4e674298d349c00d7adf5a31bdf891b3ddf1b4b24664b0e917e55"
        }
      ]
    },
    {
      "id": "one",
      "sourceIds": [
        "program-one-priorities"
      ],
      "quotes": [
        {
          "id": "dripa",
          "topic": "indigenous",
          "text": "Repeal DRIPA and declare UNDRIP to have no force and effect in BC",
          "sourceId": "program-one-priorities",
          "speaker": "OneBC",
          "textSha256": "6c62664e42bf4abd187657c96d652588e68b066c6a3ed76b57655bab478829ca"
        },
        {
          "id": "income-tax",
          "topic": "affordability",
          "text": "25% tax cuts for every single tax bracket \u2014 including corporate",
          "sourceId": "program-one-priorities",
          "speaker": "OneBC",
          "textSha256": "7f82099b9b6a849e3420075e2154af95cd436b792979cd050f6a89b2294d4e63"
        },
        {
          "id": "pst",
          "topic": "affordability",
          "text": "2% off the Provincial Sales Tax (PST)",
          "sourceId": "program-one-priorities",
          "speaker": "OneBC",
          "textSha256": "37adad063cc8552335f8fc881ab369c7a67f1a1c62e7ecdd4b96fc25db060216"
        },
        {
          "id": "pipeline",
          "topic": "economy",
          "text": "Approve a pipeline to the Port of Prince Rupert or Kitimat to get Canadian energy to foreign markets",
          "sourceId": "program-one-priorities",
          "speaker": "OneBC",
          "textSha256": "ab0d8ea60494e093a46ea535aa4a80f6694719482dcbaa12c71a130e10a64745"
        },
        {
          "id": "forestry",
          "topic": "economy",
          "text": "Reduce stumpage fees for lumber companies to make the market more competitive",
          "sourceId": "program-one-priorities",
          "speaker": "OneBC",
          "textSha256": "cd74bb476c47adfa9b191983fd6ec8a0a53e34009e59f170e47f0db553ef9c7c"
        },
        {
          "id": "balance",
          "topic": "affordability",
          "text": "Balanced budgets within 4 years, with an aim towards running surplus budgets",
          "sourceId": "program-one-priorities",
          "speaker": "OneBC",
          "textSha256": "d5c1f1cac92e1709b39385eaa74f840717fb3851021c4190963dd10ba4c44a32"
        },
        {
          "id": "healthcare",
          "topic": "health",
          "text": "Private Healthcare alongside fully-funded public healthcare",
          "sourceId": "program-one-priorities",
          "speaker": "OneBC",
          "textSha256": "8f03be5b7804f319eb1886a720d4fb775e86a9c04ec6a37f8886391404d8d485"
        },
        {
          "id": "education",
          "topic": "education",
          "text": "Bring back standardized testing \u2014 Focus on reading, writing and mathematics",
          "sourceId": "program-one-priorities",
          "speaker": "OneBC",
          "textSha256": "23ce78cd449ce5413964d0c0839ff4964a1d87c9e7577430961f7ddca23e96e8"
        },
        {
          "id": "housing",
          "topic": "housing",
          "text": "Eliminate the Step Code that is raising housing costs with unnecessary green building requirements",
          "sourceId": "program-one-priorities",
          "speaker": "OneBC",
          "textSha256": "2e3e214bb387f77789680fcc4b67bdb5ba6de9be1ae87c559a20a4d99a6dc137"
        },
        {
          "id": "drugs",
          "topic": "addiction",
          "text": "Eliminate safe supply and drug consumption programs",
          "sourceId": "program-one-priorities",
          "speaker": "OneBC",
          "textSha256": "5e6295419588ab9ea97b8729d8a1a9779874813fd4530a228874f83b9aba0391"
        },
        {
          "id": "firearms",
          "topic": "rights",
          "text": "No provincial government participation in any federal firearms buy-back or confiscation program for legally acquired firearms",
          "sourceId": "program-one-priorities",
          "speaker": "OneBC",
          "textSha256": "197731df68d1b56fc396216f9be1821b4dbb4c67cfa0eac51414732e3d35c5af"
        },
        {
          "id": "protests",
          "topic": "justice",
          "text": "No mask wearing during protests",
          "sourceId": "program-one-priorities",
          "speaker": "OneBC",
          "textSha256": "8e7797f2dfcb4c6a5201d9fe0d093cff221c589d0928ae3b66b4b05b737efc08"
        }
      ]
    },
    {
      "id": "centre",
      "sourceIds": [
        "program-centre-vision",
        "program-centre-policy"
      ],
      "quotes": [
        {
          "id": "budget",
          "topic": "affordability",
          "text": "CentreBC believes in responsible financial management\u2014balancing the budget over the long term through smarter investments and spending.",
          "sourceId": "program-centre-vision",
          "speaker": "CentreBC",
          "textSha256": "2fe6bf60e0b13edc633179c4d951dce15c8045975321854fc8e18adc1ec2e400"
        },
        {
          "id": "services",
          "topic": "affordability",
          "text": "We remain committed to protecting the health care, education, and social supports that British Columbians depend on, while ensuring every tax dollar delivers real results.",
          "sourceId": "program-centre-vision",
          "speaker": "CentreBC",
          "textSha256": "736f3feec94c63ecc6e07e708360274c6e6e49fcc1f1fceff4fabbbbc4dc16f5"
        },
        {
          "id": "housing",
          "topic": "housing",
          "text": "Our vision is clear: a province where everyone has access to housing, quality healthcare, education, and economic opportunity.",
          "sourceId": "program-centre-vision",
          "speaker": "CentreBC",
          "textSha256": "22c73e4216810025ecff63dfae172cb03cc4e9ae5b3934ad238350e0c5fea1f8"
        },
        {
          "id": "health",
          "topic": "health",
          "text": "Accessible, well-funded healthcare and mental health supports.",
          "sourceId": "program-centre-vision",
          "speaker": "CentreBC",
          "textSha256": "1fa1cb4c6060d0a1e58e0c5d694ad7ae20d1093a4338530882000ca39cca80e1"
        },
        {
          "id": "economy",
          "topic": "economy",
          "text": "We are committed to responsible economic growth, supporting small business, fostering innovation, and investing in green technology\u2014while also championing our resource industries, including mining, forestry, and energy.",
          "sourceId": "program-centre-vision",
          "speaker": "CentreBC",
          "textSha256": "b28f0153b4a4d953eddb03ad4a38843b1f2e72962ee0278503a55139f597d586"
        },
        {
          "id": "environment",
          "topic": "environment",
          "text": "We will lead with evidence-based solutions to combat climate change, protect biodiversity, and grow a sustainable economy for future generations.",
          "sourceId": "program-centre-vision",
          "speaker": "CentreBC",
          "textSha256": "5a0fbfd51ef50006502a8ceec60493b25f61bdfb01e1766dfdd7f996172f25b2"
        },
        {
          "id": "safety",
          "topic": "justice",
          "text": "Public safety backed by strong justice and treatment systems.",
          "sourceId": "program-centre-vision",
          "speaker": "CentreBC",
          "textSha256": "16046d9c73a5c52e9a5b83cfe70f4d14ba49e047b445ed2c2d16124e805d171a"
        },
        {
          "id": "education",
          "topic": "education",
          "text": "A modernized education system that equips our youth for the future.",
          "sourceId": "program-centre-vision",
          "speaker": "CentreBC",
          "textSha256": "a7033a3de9741989fc0fe0aa527b74da7607420c1bf5092ceb4cf5713fd9d065"
        },
        {
          "id": "transport",
          "topic": "transport",
          "text": "Long-term infrastructure and transportation investments.",
          "sourceId": "program-centre-vision",
          "speaker": "CentreBC",
          "textSha256": "64559d61d97d08ba41d8d0b712fec799e40fa0b57fb1aae9de1e363edc02dce5"
        },
        {
          "id": "process",
          "topic": "governance",
          "text": "Our goal is not to promise everything to everyone.",
          "sourceId": "program-centre-policy",
          "speaker": "CentreBC",
          "textSha256": "63b06eac81518bbac971d8f8edfd83bff9f69606e84649f10435993945f84644"
        }
      ]
    },
