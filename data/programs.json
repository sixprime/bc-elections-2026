    {
      "id": "libertarian",
      "sourceIds": [
        "program-libertarian-2024",
        "program-libertarian-2024-2",
        "program-libertarian-2024-3",
        "program-libertarian-2024-4",
        "program-libertarian-housing",
        "program-libertarian-health",
        "program-libertarian-education",
        "program-libertarian-transport",
        "program-libertarian-tax"
      ],
      "quotes": [
        {
          "id": "housing",
          "topic": "housing",
          "text": "Zoning laws and rent controls must be eased.",
          "sourceId": "program-libertarian-housing",
          "locator": "In Brief",
          "speaker": "BC Libertarian Party",
          "textSha256": "90326d60c2804f311ca9703b3d56531a644d7725dabb990cfdf6b186b256580a"
        },
        {
          "id": "property-tax",
          "topic": "affordability",
          "text": "Reduce or eliminate property transfer tax.",
          "sourceId": "program-libertarian-housing",
          "locator": "In Brief",
          "speaker": "BC Libertarian Party",
          "textSha256": "c50554b3aae99582e9e1cf8c4ed63f36c73c83619486aa79f987fae7bd54e0ad"
        },
        {
          "id": "health",
          "topic": "health",
          "text": "Maintain existing multiple payer system for total health care costs",
          "sourceId": "program-libertarian-health",
          "locator": "In Brief",
          "speaker": "BC Libertarian Party",
          "textSha256": "63e7276d36fe54d59b5b098c42a4dd2e17affd784b25064da21125c883f62139"
        },
        {
          "id": "education",
          "topic": "education",
          "text": "Shift authority down to regional school boards where possible;",
          "sourceId": "program-libertarian-education",
          "locator": "In BRIEF",
          "speaker": "BC Libertarian Party",
          "textSha256": "ce7ca5e3f615a1db7e9806d613fe5d2e804bd6c387dc7e46640bac8333a77583"
        },
        {
          "id": "insurance",
          "topic": "transport",
          "text": "Allow competition in all types of auto insurance and convert ICBC\u2019s insurance business into a member owned and operated co-operative.",
          "sourceId": "program-libertarian-transport",
          "locator": "In Brief",
          "speaker": "BC Libertarian Party",
          "textSha256": "764efa0df485c07aad915d0375fd2796efed08cc125d470d16db69dde6a72995"
        },
        {
          "id": "vat",
          "topic": "affordability",
          "text": "British Columbia should convert the PST into a value-added tax (VAT) like the federal Goods and Services Tax (GST) so that businesses have incentive to do things such as upgrade equipment or expand their scope of business.",
          "sourceId": "program-libertarian-tax",
          "locator": "Solution",
          "speaker": "BC Libertarian Party",
          "textSha256": "c9ebe772da20184f253594152c7a47cd67baad26ff523c1d8edd7e4b921f6211"
        }
      ]
    },
    {
      "id": "heritage",
      "sourceIds": [
        "program-heritage-platform"
      ],
      "quotes": [
        {
          "id": "principles",
          "topic": "governance",
          "text": "Our taxpayer-friendly, democracy-friendly and justice-friendly policies are based on biblical values that are pro-life, pro-family, pro-freedom and pro-fiscal sanity.",
          "sourceId": "program-heritage-platform",
          "locator": "CHP-BC Platform",
          "speaker": "Christian Heritage Party of BC",
          "textSha256": "43b0842334add7b8657f850809ed8d4c8bb43e6369240a3ce49c88bd2a22b661"
        }
      ]
    },
    {
      "id": "communist",
      "sourceIds": [
        "program-communist-platform"
      ],
      "quotes": [
        {
          "id": "taxes",
          "topic": "affordability",
          "text": "Abolish income tax on earnings under $50,000.",
          "sourceId": "program-communist-platform",
          "speaker": "Communist Party of BC",
          "textSha256": "e443bd354c06198971ef9903bc7241dcd9be3011308d4ffd031bbd24b8acc822"
        },
        {
          "id": "climate",
          "topic": "environment",
          "text": "Prioritize renewable energy and conservation. Cancel taxpayer subsidies to the LNG industry.",
          "sourceId": "program-communist-platform",
          "speaker": "Communist Party of BC",
          "textSha256": "7246fee918db5b197b308af7b4e32f570465d093d12461ec01e6f54e7ba92c0e"
        },
        {
          "id": "transit",
          "topic": "transport",
          "text": "Free public transit for all. Create an accessible province-wide bus transit system.",
          "sourceId": "program-communist-platform",
          "speaker": "Communist Party of BC",
          "textSha256": "a71200a0c417218eecc3686e5b77a1297348af9b0a1f84844b5b80d462db8cb9"
        },
        {
          "id": "labour",
          "topic": "economy",
          "text": "Raise BC minimum wage to $23, fully adjusted to annual inflation rates.",
          "sourceId": "program-communist-platform",
          "speaker": "Communist Party of BC",
          "textSha256": "adc13dd2c2472aff72d97da83ca840519c941bc7e524f2718d2d9091b9c99fd0"
        },
        {
          "id": "ownership",
          "topic": "economy",
          "text": "Put resources under public ownership and democratic control. End P3 public infrastructure projects.",
          "sourceId": "program-communist-platform",
          "speaker": "Communist Party of BC",
          "textSha256": "b2739128eb2b262c942d5a254c330b4dbaf2aea63b2872c6d81000b1fd997613"
        },
        {
          "id": "land",
          "topic": "indigenous",
          "text": "No resource extraction and infrastructure projects on indigenous lands without full consultation and approval.",
          "sourceId": "program-communist-platform",
          "speaker": "Communist Party of BC",
          "textSha256": "40e19e2c5a795618cecc4bf83b63236446a1ccdcd16d01e339cb217205a79eac"
        },
        {
          "id": "assistance",
          "topic": "rights",
          "text": "Raise social assistance and disability rates by 100%.",
          "sourceId": "program-communist-platform",
          "speaker": "Communist Party of BC",
          "textSha256": "51b2bb6bbee04727963b3b72b41da00fec068f80e328bcb0b7d2cc113cec9015"
        },
        {
          "id": "policing",
          "topic": "justice",
          "text": "Reduce police spending, and remove the provincial authority to order municipalities to increase policing budgets.",
          "sourceId": "program-communist-platform",
          "speaker": "Communist Party of BC",
          "textSha256": "79565565b6769f662dd4e2e25c816580cb48ef7f60985468568a9365880632ff"
        },
        {
          "id": "education",
          "topic": "education",
          "text": "Increase public education spending by $1000 per student to reach the Canadian average.",
          "sourceId": "program-communist-platform",
          "speaker": "Communist Party of BC",
          "textSha256": "4e1b1e5e80c950d93e452f67d9ed8153b9bdbe671ab4f6e7c6162b211e3842c3"
        },
        {
          "id": "housing",
          "topic": "housing",
          "text": "Legislation to limit rents to 20% of a family\u2019s income, and establish vacancy controls which tie rents to the unit.",
          "sourceId": "program-communist-platform",
          "speaker": "Communist Party of BC",
          "textSha256": "3109134ed108233b8dbf3828c50e4cca989545e484d7a420634fa487bb723a74"
        },
        {
          "id": "democracy",
          "topic": "governance",
          "text": "Replace \u201cfirst past the post\u201d with Mixed Member proportional representation, and set MLA salaries at the average wage of a BC worker.",
          "sourceId": "program-communist-platform",
          "speaker": "Communist Party of BC",
          "textSha256": "e23c96d3accfb878182c0f04bd868cb698a4fff77964afaa6ec15fe0a4a72258"
        },
        {
          "id": "food",
          "topic": "environment",
          "text": "End removals from the Agricultural Land Reserve, encourage food production in urban areas.",
          "sourceId": "program-communist-platform",
          "speaker": "Communist Party of BC",
          "textSha256": "e828856876620acea88e78a4c81202653cd7e461d2e6d24b5742d973fbb0b533"
        }
      ]
    },
    {
      "id": "freedom",
      "sourceIds": [
        "program-freedom-platform"
      ],
      "quotes": [
        {
          "id": "schools",
          "topic": "education",
          "text": "Make our K-12 schools competitive with international academic levels, so that every child has confidence and is motivated to pursue post secondary education.",
          "sourceId": "program-freedom-platform",
          "speaker": "Freedom Party of British Columbia",
          "textSha256": "ec4f5b3d8914cc4c51fb2cf4969edc425f256de38e0a73771e3d6069d89bd2a5"
        },
        {
          "id": "housing",
          "topic": "housing",
          "text": "End foreign ownership of BC housing and agricultural land until further notice.",
          "sourceId": "program-freedom-platform",
          "speaker": "Freedom Party of British Columbia",
          "textSha256": "b1ae76c8ba0243292dfcf54a63eda53bd978d204f394cd55a33dff9d511ede2a"
        },
        {
          "id": "employment",
          "topic": "health",
          "text": "All employees terminated due to COVID policy will be re-hired with apology.",
          "sourceId": "program-freedom-platform",
          "speaker": "Freedom Party of British Columbia",
          "textSha256": "62149e6b35c0969404d2d7f74aab991fc71ba25f76783cc51fbbe0e97cdf2569"
        },
        {
          "id": "police",
          "topic": "justice",
          "text": "Explore the benefits of British Columbia Provincial Police over RCMP and Municipal Police Forces.",
          "sourceId": "program-freedom-platform",
          "speaker": "Freedom Party of British Columbia",
          "textSha256": "3beeaabb34564487fba1ec498284e9006859368fe720202a46f2e1f2484da145"
        },
        {
          "id": "firearms",
          "topic": "rights",
          "text": "Legal firearm owners will not be harassed or marginalized in the province of British Columbia.",
          "sourceId": "program-freedom-platform",
          "speaker": "Freedom Party of British Columbia",
          "textSha256": "4c87db2f8180d054e9a21bbb02daf6cf21e75d7bb238f7f7ee4daf9d5d215b1d"
        },
        {
          "id": "government",
          "topic": "governance",
          "text": "Government exists to serve people, it will not intimidate people.",
          "sourceId": "program-freedom-platform",
          "speaker": "Freedom Party of British Columbia",
          "textSha256": "1de48984f8f8395118afa1e13360d3929c4e55d566d06a6dcb1a797ff56e8281"
        },
        {
          "id": "resources",
          "topic": "economy",
          "text": "We will support and cherish our natural resource industry.",
          "sourceId": "program-freedom-platform",
          "speaker": "Freedom Party of British Columbia",
          "textSha256": "fe27291c3a1a6ca5c650495ffec5bed19de25baa635de9bfc53beece4a829cf3"
        },
        {
          "id": "taxes",
          "topic": "affordability",
          "text": "Taxes should be lowered all around to spur growth of industries, who in turn generate employment.",
          "sourceId": "program-freedom-platform",
          "speaker": "Freedom Party of British Columbia",
          "textSha256": "e7e1b5403af54c826ca8a10b5e59ef18404bc9ad6c772a439e44c8b89c855b51"
        }
      ]
    },
