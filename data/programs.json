  "parties": [
    {
      "id": "ndp",
      "sourceIds": [
        "program-ndp-priorities"
      ],
      "quotes": [
        {
          "id": "costs",
          "topic": "affordability",
          "text": "We believe you should be able to save more and get ahead.",
          "sourceId": "program-ndp-priorities",
          "speaker": "BC NDP",
          "textSha256": "85cce72c4073a70ad40036ab827b7aabff1e39b684ed120c33c20096da74655d"
        },
        {
          "id": "housing",
          "topic": "housing",
          "text": "We\u2019ve fixed restrictive and outdated rules that were blocking townhouses, row homes and duplexes.",
          "sourceId": "program-ndp-priorities",
          "speaker": "BC NDP",
          "textSha256": "ef63f782e39851c37111349e9f611d17a7a9df5a49bf2f212f69d2ca94e9898a"
        },
        {
          "id": "care",
          "topic": "health",
          "text": "We\u2019ve invested in primary care, home health, long-term care and assisted living services throughout BC.",
          "sourceId": "program-ndp-priorities",
          "speaker": "BC NDP",
          "textSha256": "f104ce4c135d2b966ae5f8463907783747018b97b199566115b208628d2cff0a"
        },
        {
          "id": "childcare",
          "topic": "education",
          "text": "Cut childcare costs in half on average (saving families up to $900/month per child)",
          "sourceId": "program-ndp-priorities",
          "speaker": "BC NDP",
          "textSha256": "e32ee66049f13d00d2ecb32f6f189347b3c04de550124a7c80a563c97e0aee44"
        },
        {
          "id": "sick-leave",
          "topic": "economy",
          "text": "We\u2019ve made it so you can now take 5 paid sick days a year under minimum employment standards.",
          "sourceId": "program-ndp-priorities",
          "speaker": "BC NDP",
          "textSha256": "0e65566348d11907259cb5d31a9ecb8233ed90d93c6158a2e31631c0baea7107"
        },
        {
          "id": "safety",
          "topic": "justice",
          "text": "We\u2019re keeping repeat violent offenders off the street with stricter bail rules and stronger enforcement.",
          "sourceId": "program-ndp-priorities",
          "speaker": "BC NDP",
          "textSha256": "bb73217e1151577409c039b3b6f2d356ce77095a56a7ae348ccc599651ed3319"
        },
        {
          "id": "disaster-risk",
          "topic": "environment",
          "text": "We funded local governments and First Nations to reduce disaster risk, with $39 million for more than 50 local projects.",
          "sourceId": "program-ndp-priorities",
          "speaker": "BC NDP",
          "textSha256": "c6d8c38e13d6bddfc0f10aa1a1821fa78dd208f0d357901bba2871fd8496c7f8"
        }
      ]
    },
    {
